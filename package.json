{
  "name": "@howellandgibbs/hpd-lookup",
  "version": "0.1.0",
  "description": "Look up NYC HPD housing violations by address or BBL, and translate them into plain English. Zero runtime dependencies.",
  "license": "MIT",
  "author": "Howell & Gibbs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js",
      "require": "./dist/widget/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "npm run build && python3 -m http.server 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "hpd",
    "nyc",
    "housing",
    "violations",
    "tenant",
    "civic-tech",
    "open-data",
    "socrata",
    "geosearch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howellandgibbs/hpd-lookup.git"
  },
  "homepage": "https://github.com/howellandgibbs/hpd-lookup#readme",
  "bugs": {
    "url": "https://github.com/howellandgibbs/hpd-lookup/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
